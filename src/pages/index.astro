---
import { getCollection } from 'astro:content';
import { getSortedPapers } from '../lib/collections';
import { SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import PaperItem from '../components/PaperItem.astro';

// 首页的论文栏与论文列表页共用同一个取数入口（lib/collections），排序与预检都在那里。
// 取前 3 条、「查看全部 →」与个人介绍由 #14 组装；本票只保证「同一套排序不是两个地方
// 各写一遍」，所以这一栏现在就渲染真卡片，而不是条目标识。
const papers = await getSortedPapers();const projects = await getCollection('projects');
const notes = await getCollection('notes');
---

<BaseLayout>
  <h1>{SITE_TITLE}</h1>

  <section>
    <h2>论文</h2>
    {
      /*
        论文栏与列表页共用 PaperItem 与同一套排序——这条是 #11 的验收判据：
        「列表页与首页取数共用同一套排序，不各写一遍」。
        取前 3 条与「查看全部 →」留给 #14。
      */
    }
    {papers.length === 0 ? <EmptyState label="论文" /> : <ul class="paper-list">{papers.map((paper) => <PaperItem paper={paper} />)}</ul>}
  </section>

  <section>
    <h2>项目</h2>
    {projects.length === 0 ? <EmptyState label="项目" /> : <ul>{projects.map((entry) => <li>{entry.id}</li>)}</ul>}
  </section>

  <section>
    <h2>分享</h2>
    {notes.length === 0 ? <EmptyState label="分享" /> : <ul>{notes.map((entry) => <li>{entry.id}</li>)}</ul>}
  </section>
</BaseLayout>
