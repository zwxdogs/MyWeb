---
import { getSortedPapers } from '../../lib/collections';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import PaperItem from '../../components/PaperItem.astro';

// 取数走 lib/collections 的同一个入口：排序（年份降序 → 月份降序 → slug 升序）与
// 预检都在那里，首页也调它，两处顺序不可能漂移。
const papers = await getSortedPapers();
---

<BaseLayout title="论文">
  <h1>论文</h1>
  {papers.length === 0 ? <EmptyState label="论文" /> : <ul class="paper-list">{papers.map((paper) => <PaperItem paper={paper} />)}</ul>}
</BaseLayout>
